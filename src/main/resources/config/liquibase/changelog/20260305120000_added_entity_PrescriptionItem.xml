<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260305120000-1" author="codex">
        <createTable tableName="prescription_item">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="duration" type="integer"/>
            <column name="frequency" type="integer"/>
            <column name="medication_name" type="varchar(255)"/>
            <column name="medication_dosage" type="integer"/>
            <column name="instructions" type="varchar(2000)"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
