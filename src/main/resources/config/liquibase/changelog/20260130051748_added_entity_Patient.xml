<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260130051748-1" author="jhipster">
        <createTable tableName="patient">
            <column name="id" type="integer">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="nom" type="varchar(255)"/>
            <column name="last_name" type="varchar(255)"/>
            <column name="first_name" type="varchar(255)"/>
            <column name="date_birth" type="date"/>
            <column name="phone" type="varchar(255)"/>
            <column name="email" type="varchar(255)"/>
            <column name="address" type="varchar(255)"/>
            <column name="blood_type" type="varchar(255)"/>
            <column name="allergies" type="varchar(255)"/>
            <column name="notes" type="varchar(255)"/>
            <column name="emergency_contact_name" type="varchar(255)"/>
            <column name="emeregency_contact_phone" type="varchar(255)"/>
            <column name="chronicdiseases" type="varchar(255)"/>
            <column name="medical_history" type="varchar(255)"/>
        </createTable>
    </changeSet>

</databaseChangeLog>